# --- Database ---
# Postgres consigliato in produzione (dati sensibili di uno studio legale).
DATABASE_URL="postgresql://user:password@localhost:5432/druetta_platform?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"

# --- Google OAuth (login, Drive, Gmail) ---
# Creare credenziali OAuth 2.0 su Google Cloud Console, abilitare Drive API e Gmail API.
GOOGLE_CLIENT_ID="CHANGE_ME.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="CHANGE_ME"

# Dominio/e email autorizzate ad accedere (separate da virgola). Lasciare vuoto per non filtrare.
ALLOWED_EMAIL_DOMAINS="studiolegale.it"
# Email dell'amministratore iniziale (riceve automaticamente il ruolo ADMIN al primo login)
INITIAL_ADMIN_EMAIL="admin@studiolegale.it"

# Nota: le cartelle/i documenti Drive dei fascicoli NON vengono mai creati da
# questa piattaforma. Vanno creati a mano (seguendo la convenzione di
# nomenclatura dello studio) e collegati incollandone il link nel form del
# fascicolo: la piattaforma si limita a verificarne l'esistenza.

# Cartella Drive che raccoglie le sottocartelle di TUTTE le cause pendenti
# (una per fascicolo, con nome anno_rg_parte_controparte_tribunale). Usata in
# sola lettura dalla scansione periodica per trovare/collegare cartelle nuove
# o non ancora agganciate a un fascicolo: opzionale, se non impostata la
# scansione è disattivata e resta solo il collegamento manuale.
GOOGLE_DRIVE_CARTELLA_PENDENTI_ID="CHANGE_ME"

# File Excel su Drive da cui importare periodicamente i dati delle cause
# (ID dal link del file, non di una cartella). Opzionale: se non impostato
# l'import automatico è disattivato.
GOOGLE_DRIVE_FILE_CAUSE_ID="CHANGE_ME"

# File Excel su Drive da cui importare periodicamente le pratiche
# (licenziamenti/cause singole di riders e non). Opzionale: se non impostato
# l'import automatico è disattivato (l'import manuale da /dashboard/pratiche
# resta comunque disponibile se l'utente ha il permesso "pratiche:scrivi").
GOOGLE_DRIVE_FILE_PRATICHE_ID="CHANGE_ME"

# --- Crittografia campi sensibili (codice fiscale, note) ---
# Genera con: openssl rand -hex 32
FIELD_ENCRYPTION_KEY="CHANGE_ME_64_HEX_CHARS"

# --- Cron / job schedulati (promemoria, scansione Drive, import Excel) ---
# Token segreto richiesto per invocare /api/email/automatiche,
# /api/drive/scansione e /api/cause/importa-excel da un job schedulato
CRON_SECRET="CHANGE_ME"
