generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Autenticazione (NextAuth) e ruoli
// ---------------------------------------------------------------------------

enum Role {
  ADMIN       // accesso completo, gestione utenti
  AVVOCATO    // accesso completo a cause/clienti, non gestisce utenti
  SEGRETERIA  // inserimento/modifica dati, invio email, no eliminazioni definitive
  SOLA_LETTURA // solo consultazione
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(SOLA_LETTURA)
  attivo        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  auditLogs  AuditLog[]
  emailsSent EmailLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Cause (fascicoli) - un record per riga dei fogli "Pendenti / Concluse / Esecuzioni"
// ---------------------------------------------------------------------------

enum StatoCausa {
  PENDENTI
  CONCLUSE
  ESECUZIONI
}

model Causa {
  id              String     @id @default(cuid())
  stato           StatoCausa @default(PENDENTI)

  fascicolo       String     // Fascicolo
  driveFolderId   String?    // id cartella Drive collegata (colonna "Drive")
  driveFolderUrl  String?
  tribunale       String?
  rg              String?    // R.G.
  ricorrenti      String?    // Nomi ricorrenti
  controparte     String?
  ultimaUdienza   DateTime?  // data dell'ultima udienza svolta
  dataUdienza     DateTime?  // data della prossima udienza fissata
  adempimenti     String?
  termine         DateTime?
  fattoONo        Boolean    @default(false)
  propostaTrasmessa Boolean  @default(false)
  dataProposta    DateTime?
  note            String?    @db.Text
  procure185      Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clienti         ClienteCausa[]
  documenti       DocumentoDrive[]
  emailLog        EmailLog[]
  audit           AuditLog[]
  conflittiImport ImportCauseConflitto[]

  @@index([stato])
  @@index([rg])
}

// ---------------------------------------------------------------------------
// Clienti - un record per riga del foglio "Clienti"
// ---------------------------------------------------------------------------

model Cliente {
  id       String  @id @default(cuid())
  citta    String?
  cognome  String
  nome     String
  piattaforma String?
  note        String? @db.Text

  natoA        String?   // "nato a"
  natoIl       DateTime? // "il ..."
  residenteIn  String?

  // Campo cifrato (AES-256-GCM) a livello applicativo: contiene il JSON {iv, tag, data}
  codiceFiscaleCifrato String? @db.Text

  richiestaDati      Boolean  @default(false)
  orario             String?
  periodoDiLavoro    String?
  mezzo              String?
  dataRicevimento    DateTime?
  email              String?
  numero             String?
  pagamento          String?
  iscritto           Boolean  @default(false)
  docMancanti        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cause     ClienteCausa[]
  audit     AuditLog[]

  @@index([cognome, nome])
}

// ---------------------------------------------------------------------------
// Collegamento Clienti <-> Cause (foglio di raccordo con RG e ultimi documenti Drive)
// ---------------------------------------------------------------------------

model ClienteCausa {
  id        String   @id @default(cuid())
  clienteId String
  causaId   String

  ruoloCliente String? // es. ricorrente, controparte, terzo
  ultimoDocumentoNome String? // es. "Verbale udienza 12/03/2026"
  ultimoDocumentoDriveId String?
  ultimoDocumentoUrl     String?
  ultimoDocumentoData    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  causa   Causa   @relation(fields: [causaId], references: [id], onDelete: Cascade)

  @@unique([clienteId, causaId])
  @@index([causaId])
  @@index([clienteId])
}

// ---------------------------------------------------------------------------
// Documenti Google Drive collegati a una causa (cache locale dei metadati)
// ---------------------------------------------------------------------------

model DocumentoDrive {
  id            String   @id @default(cuid())
  causaId       String
  driveFileId   String
  nome          String
  mimeType      String?
  webViewLink   String?
  tipo          String?  // es. "verbale", "atto", "procura"
  caricatoDaId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  causa Causa @relation(fields: [causaId], references: [id], onDelete: Cascade)

  @@index([causaId])
  @@unique([driveFileId])
}

// ---------------------------------------------------------------------------
// Suggerimenti da scansione automatica di Drive: la cartella "cause pendenti"
// viene scansionata periodicamente (cron) per trovare cartelle nuove o non
// ancora collegate, individuate tramite ANNO_RG nel nome. Il collegamento a
// una causa esistente non ambiguo avviene in automatico; tutto il resto
// (cartelle senza causa corrispondente, RG duplicati, nomi non riconosciuti)
// finisce in coda per la conferma di un avvocato/segreteria: questa
// piattaforma non crea mai da sola un nuovo fascicolo.
// ---------------------------------------------------------------------------

enum TipoSuggerimentoCartella {
  NUOVA_CAUSA     // nessuna causa esistente con lo stesso ANNO_RG
  CONFLITTO_RG    // ANNO_RG ambiguo: piu' cause corrispondono, o la causa trovata e' gia' collegata a un'altra cartella
  NON_RICONOSCIUTA // il nome della cartella non rispetta la convenzione anno_rg_...
}

enum StatoSuggerimentoCartella {
  IN_ATTESA
  APPROVATA
  RIFIUTATA
}

model SuggerimentoCartella {
  id              String                    @id @default(cuid())
  driveFolderId   String                    @unique
  driveFolderUrl  String?
  nomeCartella    String
  anno            String?
  rg              String?
  tipo            TipoSuggerimentoCartella
  causeCandidate  Json?                     // per CONFLITTO_RG: [{causaId, fascicolo, tribunale}]
  stato           StatoSuggerimentoCartella @default(IN_ATTESA)
  causaCollegataId String?
  createdAt       DateTime                  @default(now())
  aggiornatoIl    DateTime                  @updatedAt

  @@index([stato])
}

// ---------------------------------------------------------------------------
// Import periodico delle cause da file Excel su Drive. Ogni riga viene
// abbinata a una causa esistente tramite R.G.: se non c'e' corrispondenza si
// crea una nuova causa (l'Excel e' considerato fonte autorevole per i
// fascicoli nuovi), se c'e' corrispondenza i campi vuoti in piattaforma
// vengono completati ma un valore gia' presente e diverso da quello
// nell'Excel non viene MAI sovrascritto in automatico: finisce in coda come
// ImportCauseConflitto per una scelta manuale.
// ---------------------------------------------------------------------------

enum StatoConflittoImport {
  IN_ATTESA
  TENUTO_VALORE_ATTUALE
  APPLICATO_VALORE_EXCEL
}

model ImportCauseConflitto {
  id             String               @id @default(cuid())
  importLogId    String
  causaId        String
  campo          String               // nome del campo Causa in conflitto
  valoreAttuale  String?
  valoreExcel    String?
  rigaExcel      Int
  stato          StatoConflittoImport @default(IN_ATTESA)
  createdAt      DateTime             @default(now())

  importLog ImportCauseLog @relation(fields: [importLogId], references: [id], onDelete: Cascade)
  causa     Causa          @relation(fields: [causaId], references: [id], onDelete: Cascade)

  @@index([stato])
  @@index([causaId])
}

model ImportCauseLog {
  id                String   @id @default(cuid())
  eseguitoIl        DateTime @default(now())
  eseguitoDaId      String?  // null se lanciato dal cron
  righeTotali       Int
  righeCreate       Int
  righeAggiornate   Int      // cause esistenti con almeno un campo vuoto completato
  righeInvariate    Int
  righeConflitto    Int
  righeScartate     Int
  dettagliScartate  Json?    // [{riga, motivo}]

  conflitti ImportCauseConflitto[]
}

// ---------------------------------------------------------------------------
// Log invii email (automatiche e manuali)
// ---------------------------------------------------------------------------

enum EmailStato {
  INVIATA
  FALLITA
  IN_CODA
}

model EmailLog {
  id         String     @id @default(cuid())
  causaId    String?
  destinatario String
  oggetto      String
  corpo        String   @db.Text
  stato        EmailStato @default(IN_CODA)
  errore       String?
  inviataDaId  String?
  automatica   Boolean  @default(false)
  createdAt    DateTime @default(now())

  causa    Causa? @relation(fields: [causaId], references: [id], onDelete: SetNull)
  inviataDa User?  @relation(fields: [inviataDaId], references: [id], onDelete: SetNull)

  @@index([causaId])
}

// ---------------------------------------------------------------------------
// Audit trail (obbligatorio per dati di uno studio legale)
// ---------------------------------------------------------------------------

enum AuditAzione {
  CREAZIONE
  MODIFICA
  ELIMINAZIONE
  ACCESSO
}

model AuditLog {
  id         String      @id @default(cuid())
  azione     AuditAzione
  entita     String      // "Causa" | "Cliente" | "ClienteCausa" | ...
  entitaId   String?
  utenteId   String?
  prima      Json?
  dopo       Json?
  createdAt  DateTime    @default(now())

  utente User?   @relation(fields: [utenteId], references: [id], onDelete: SetNull)
  causa   Causa?  @relation(fields: [causaId], references: [id], onDelete: SetNull)
  causaId String?
  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  clienteId String?

  @@index([entita, entitaId])
  @@index([utenteId])
}

// ---------------------------------------------------------------------------
// Pratiche (licenziamenti e cause singole): entità separata dalla Causa
// (contenzioso vero e proprio in tribunale, con Tribunale/R.G./udienze). I
// campi qui riflettono il tracciamento pre/post contenzioso usato dallo
// studio: scadenze di impugnativa, invio della lettera di licenziamento,
// procura, e - una volta ottenuta una sentenza/accordo - il recupero del
// credito (esecuzione, pagamenti).
// ---------------------------------------------------------------------------

enum StatoPratica {
  PENDENTI
  CONCLUSE
  IN_ESECUZIONE
  DA_PAGARE
  DIMESSI_ESCLUSI
}

// Derivata dal testo libero di "tipologia" per poter filtrare la vista
// unica con le pills Raiders / Cause singole: non è un dato immesso a mano,
// va sempre ricalcolata quando cambia la tipologia (vedi src/lib/pratiche.ts).
enum CategoriaPratica {
  RAIDER
  CAUSA_SINGOLA
  DA_CLASSIFICARE
}

model Pratica {
  id       String           @id @default(cuid())
  stato    StatoPratica      @default(PENDENTI)
  categoria CategoriaPratica @default(DA_CLASSIFICARE)
  tipologia String?          // testo originale (es. "Licenziamento", "Causa singola", "Sospensione account")

  driveFolderId  String? @unique
  driveFolderUrl String?

  rg     String? // formato non uniforme nella fonte reale: testo libero, non validato con regex
  citta  String?
  nome    String?
  cognome String?
  // Campo cifrato (stesso schema di Cliente.codiceFiscaleCifrato): nei dati
  // reali questa colonna contiene un blob non strutturato (data/luogo di
  // nascita, residenza, codice fiscale insieme), cifrato per intero.
  datiAnagraficiCifrato String? @db.Text

  controparte  String?
  appuntamenti String? @db.Text
  note         String? @db.Text
  email        String?
  telefono     String?

  scadenza           DateTime?
  impugnativa        DateTime?
  dataLicenziamento  DateTime?
  cartaceo           Boolean   @default(false)
  procura            Boolean   @default(false)
  // Testo libero: nella fonte reale mescola note e date (es. "nota n. 11 9/4/2026")
  emissioneFatturaSpeseLegali String?
  pagatoCapitale              Boolean @default(false)
  pagatoSpeseLegali           Boolean @default(false)
  precetto                    String? @db.Text
  esecuzione                  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conflittiImport ImportPraticaConflitto[]

  @@index([stato])
  @@index([categoria])
}

enum StatoConflittoImportPratica {
  IN_ATTESA
  TENUTO_VALORE_ATTUALE
  APPLICATO_VALORE_EXCEL
}

model ImportPraticaConflitto {
  id            String                      @id @default(cuid())
  importLogId   String
  praticaId     String
  campo         String
  valoreAttuale String?
  valoreExcel   String?
  rigaExcel     Int
  stato         StatoConflittoImportPratica @default(IN_ATTESA)
  createdAt     DateTime                    @default(now())

  importLog ImportPraticaLog @relation(fields: [importLogId], references: [id], onDelete: Cascade)
  pratica   Pratica          @relation(fields: [praticaId], references: [id], onDelete: Cascade)

  @@index([stato])
  @@index([praticaId])
}

model ImportPraticaLog {
  id               String   @id @default(cuid())
  eseguitoIl       DateTime @default(now())
  eseguitoDaId     String?
  righeTotali      Int
  righeCreate      Int
  righeAggiornate  Int
  righeInvariate   Int
  righeConflitto   Int
  righeScartate    Int
  dettagliScartate Json?

  conflitti ImportPraticaConflitto[]
}
